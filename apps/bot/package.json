    "@sern/publisher": "^1.1.4",
    "@spark.ts/logger": "^1.4.0",
    "colorette": "^2.0.20",
    "discord-api-types": "^0.38.55",
    "discord.js": "^14.20.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "superagent": "^10.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/superagent": "^8.1.9",
    "typescript": "^7.0.2"
  },
