{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "declaration": true,
    "sourceMap": false,
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "removeComments": true
  },
  "include": ["src/**/*"],
  "types": ["node"]
}
